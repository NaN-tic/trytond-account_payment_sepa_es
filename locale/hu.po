#, python-format
msgctxt ""
"model:ir.message,text:bad_relation_mandate_number_vs_bank_account_numbers"
msgid ""
"The mandate \"%(mandate)s\" for payment \"%(payment)s\" of party "
"\"%(party)s\" with amount \"%(amount)s\" is not for the move line bank "
"accounts \"%(bank_account_numbers)s\"."
msgstr ""
"A(z) „%(party)s” partner „%(amount)s” összegű „%(payment)s” fizetésének "
"„%(mandate)s” felhatalmazása nem a könyvelési sor „%(bank_account_numbers)s”"
" bankszámláira vonatkozik."

#, python-format
msgctxt "model:ir.message,text:cancel_with_processing_payments"
msgid ""
"Mandate \"%(mandate)s\" can not be canceled because it is linked to payment "
"\"%(payment)s\" which is still in process."
msgstr ""
"A(z) „%(mandate)s” felhatalmazás nem vonható vissza, mert a még feldolgozás "
"alatt álló „%(payment)s” fizetéshez kapcsolódik."

#, python-format
msgctxt "model:ir.message,text:canceled_mandate"
msgid ""
"Payment \"%(payment)s\" can not be modified because its mandate "
"\"%(mandate)s\" is canceled."
msgstr ""
"A(z) „%(payment)s” fizetés nem módosítható, mert a(z) „%(mandate)s” "
"felhatalmazását visszavonták."

#, python-format
msgctxt "model:ir.message,text:invalid_payment_date"
msgid ""
"Invalid payment date %(payment_date)s for payment \"%(payment)s\". "
"Payment\\'s date must be greather or equal than today."
msgstr ""
"A(z) „%(payment)s” fizetés %(payment_date)s dátuma érvénytelen. A fizetési "
"dátum nem lehet korábbi a mai napnál."

#, python-format
msgctxt "model:ir.message,text:msg_bad_relation_party_bank_account"
msgid ""
"The line of party \"%(party)s\" with amount \"%(amount)s\" has a bank "
"account \"%(account)s\" with a different owner."
msgstr ""
"A(z) „%(party)s” partner „%(amount)s” összegű tételének „%(account)s” "
"bankszámlája más tulajdonoshoz tartozik."

#, python-format
msgctxt "model:ir.message,text:msg_mandate_not_correct"
msgid ""
"The line of party \"%(party)s\" with amount \"%(amount)s\" and bank account "
"\"%(account)s\" has a Mandate \"%(mandate)s\" with and incorrect account "
"\"%(mandate_account)s\"."
msgstr ""
"A(z) „%(party)s” partner „%(amount)s” összegű, „%(account)s” bankszámlájú "
"tételének „%(mandate)s” felhatalmazásán hibás „%(mandate_account)s” számla "
"szerepel."

#, python-format
msgctxt "model:ir.message,text:msg_mandate_state_not_valid"
msgid ""
"The line of party \"%(party)s\" with amount \"%(amount)s\" and bank account "
"\"%(account)s\" has an invalid Mandate \"%(mandate)s\"."
msgstr ""
"A(z) „%(party)s” partner „%(amount)s” összegű, „%(account)s” bankszámlájú "
"tételének „%(mandate)s” felhatalmazása érvénytelen."

#, python-format
msgctxt "model:ir.message,text:msg_missing_sepa_bank_account_number"
msgid ""
"Process method from journal \"%(journal)s\" is \"sepa\" but is missing the "
"bank account number."
msgstr ""
"A(z) „%(journal)s” napló feldolgozási módja „sepa”, de hiányzik a "
"bankszámlaszám."

#, python-format
msgctxt "model:ir.message,text:msg_payment_without_bank_account"
msgid ""
"The line of party \"%(party)s\" with amount \"%(amount)s\" has not bank "
"account."
msgstr ""
"A(z) „%(party)s” partner „%(amount)s” összegű tételéhez nincs bankszámla."

#, python-format
msgctxt "model:ir.message,text:msg_payment_without_mandate"
msgid ""
"The line of party \"%(party)s\" with amount \"%(amount)s\" and bank account "
"\"%(account)s\" has not found Mandate."
msgstr ""
"A(z) „%(party)s” partner „%(amount)s” összegű, „%(account)s” bankszámlájú "
"tételéhez nem található felhatalmazás."

#, python-format
msgctxt "model:ir.message,text:no_bank_account"
msgid ""
"Payment \"%(payment)s\" of party \"%(party)s\" with amount \"%(amount)s\" "
"hasn't bank account."
msgstr ""
"A(z) „%(party)s” partner „%(amount)s” összegű „%(payment)s” fizetéséhez "
"nincs bankszámla."

#, python-format
msgctxt "model:ir.message,text:no_creditor_identifier"
msgid "No creditor identifier for party \"%(party)s\"."
msgstr "A(z) „%(party)s” partnernek nincs beszedőazonosítója."

#, python-format
msgctxt "model:ir.message,text:no_mandate_for_party"
msgid ""
"No valid mandate for payment \"%(payment)s\" of party \"%(party)s\" with "
"amount \"%(amount)s\"."
msgstr ""
"Nincs érvényes felhatalmazás a(z) „%(party)s” partner „%(payment)s” "
"fizetéséhez, amelynek összege „%(amount)s”."

