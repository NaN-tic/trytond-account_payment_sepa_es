#, python-format
msgctxt ""
"model:ir.message,text:bad_relation_mandate_number_vs_bank_account_numbers"
msgid ""
"The mandate \"%(mandate)s\" for payment \"%(payment)s\" of party "
"\"%(party)s\" with amount \"%(amount)s\" is not for the move line bank "
"accounts \"%(bank_account_numbers)s\"."
msgstr ""
"លិខិតអនុញ្ញាត «%(mandate)s» សម្រាប់ការទូទាត់ «%(payment)s» របស់ភាគី "
"«%(party)s» ក្នុងចំនួនទឹកប្រាក់ «%(amount)s» "
"មិនត្រូវនឹងគណនីធនាគារនៃបន្ទាត់កំណត់ត្រា «%(bank_account_numbers)s»។"

#, python-format
msgctxt "model:ir.message,text:cancel_with_processing_payments"
msgid ""
"Mandate \"%(mandate)s\" can not be canceled because it is linked to payment "
"\"%(payment)s\" which is still in process."
msgstr ""
"មិនអាចបោះបង់លិខិតអនុញ្ញាត «%(mandate)s» បានទេ ព្រោះវាភ្ជាប់ទៅការទូទាត់ "
"«%(payment)s» ដែលកំពុងដំណើរការ។"

#, python-format
msgctxt "model:ir.message,text:canceled_mandate"
msgid ""
"Payment \"%(payment)s\" can not be modified because its mandate "
"\"%(mandate)s\" is canceled."
msgstr ""
"មិនអាចកែប្រែការទូទាត់ «%(payment)s» បានទេ ព្រោះលិខិតអនុញ្ញាត «%(mandate)s» "
"របស់វាត្រូវបានបោះបង់។"

#, python-format
msgctxt "model:ir.message,text:invalid_payment_date"
msgid ""
"Invalid payment date %(payment_date)s for payment \"%(payment)s\". "
"Payment\\'s date must be greather or equal than today."
msgstr ""
"កាលបរិច្ឆេទទូទាត់ %(payment_date)s មិនត្រឹមត្រូវសម្រាប់ការទូទាត់ "
"«%(payment)s»។ កាលបរិច្ឆេទទូទាត់ត្រូវចាប់ពីថ្ងៃនេះតទៅ។"

#, python-format
msgctxt "model:ir.message,text:msg_bad_relation_party_bank_account"
msgid ""
"The line of party \"%(party)s\" with amount \"%(amount)s\" has a bank account"
" \"%(account)s\" with a different owner."
msgstr ""
"បន្ទាត់របស់ភាគី «%(party)s» ក្នុងចំនួនទឹកប្រាក់ «%(amount)s» មានគណនីធនាគារ "
"«%(account)s» ដែលមានម្ចាស់ផ្សេង។"

#, python-format
msgctxt "model:ir.message,text:msg_mandate_not_correct"
msgid ""
"The line of party \"%(party)s\" with amount \"%(amount)s\" and bank account "
"\"%(account)s\" has a Mandate \"%(mandate)s\" with and incorrect account "
"\"%(mandate_account)s\"."
msgstr ""
"បន្ទាត់របស់ភាគី «%(party)s» ក្នុងចំនួនទឹកប្រាក់ «%(amount)s» និងគណនីធនាគារ "
"«%(account)s» មានលិខិតអនុញ្ញាត «%(mandate)s» ដែលមានគណនីមិនត្រឹមត្រូវ "
"«%(mandate_account)s»។"

#, python-format
msgctxt "model:ir.message,text:msg_mandate_state_not_valid"
msgid ""
"The line of party \"%(party)s\" with amount \"%(amount)s\" and bank account "
"\"%(account)s\" has an invalid Mandate \"%(mandate)s\"."
msgstr ""
"បន្ទាត់របស់ភាគី «%(party)s» ក្នុងចំនួនទឹកប្រាក់ «%(amount)s» និងគណនីធនាគារ "
"«%(account)s» មានលិខិតអនុញ្ញាត «%(mandate)s» ដែលមិនមានសុពលភាព។"

#, python-format
msgctxt "model:ir.message,text:msg_missing_sepa_bank_account_number"
msgid ""
"Process method from journal \"%(journal)s\" is \"sepa\" but is missing the "
"bank account number."
msgstr ""
"វិធីដំណើរការនៃទិនានុប្បវត្តិ «%(journal)s» គឺ «sepa» "
"ប៉ុន្តែខ្វះលេខគណនីធនាគារ។"

#, python-format
msgctxt "model:ir.message,text:msg_payment_without_bank_account"
msgid ""
"The line of party \"%(party)s\" with amount \"%(amount)s\" has not bank "
"account."
msgstr ""
"បន្ទាត់របស់ភាគី «%(party)s» ក្នុងចំនួនទឹកប្រាក់ «%(amount)s» "
"មិនមានគណនីធនាគារ។"

#, python-format
msgctxt "model:ir.message,text:msg_payment_without_mandate"
msgid ""
"The line of party \"%(party)s\" with amount \"%(amount)s\" and bank account "
"\"%(account)s\" has not found Mandate."
msgstr ""
"រកមិនឃើញលិខិតអនុញ្ញាតសម្រាប់បន្ទាត់របស់ភាគី «%(party)s» ក្នុងចំនួនទឹកប្រាក់ "
"«%(amount)s» និងគណនីធនាគារ «%(account)s»។"

#, python-format
msgctxt "model:ir.message,text:no_bank_account"
msgid ""
"Payment \"%(payment)s\" of party \"%(party)s\" with amount \"%(amount)s\" "
"hasn't bank account."
msgstr ""
"ការទូទាត់ «%(payment)s» របស់ភាគី «%(party)s» ក្នុងចំនួនទឹកប្រាក់ «%(amount)s»"
" មិនមានគណនីធនាគារ។"

#, python-format
msgctxt "model:ir.message,text:no_creditor_identifier"
msgid "No creditor identifier for party \"%(party)s\"."
msgstr "គ្មានលេខសម្គាល់ម្ចាស់បំណុលសម្រាប់ភាគី «%(party)s»។"

#, python-format
msgctxt "model:ir.message,text:no_mandate_for_party"
msgid ""
"No valid mandate for payment \"%(payment)s\" of party \"%(party)s\" with "
"amount \"%(amount)s\"."
msgstr ""
"គ្មានលិខិតអនុញ្ញាតត្រឹមត្រូវសម្រាប់ការទូទាត់ «%(payment)s» របស់ភាគី "
"«%(party)s» ក្នុងចំនួនទឹកប្រាក់ «%(amount)s»។"

