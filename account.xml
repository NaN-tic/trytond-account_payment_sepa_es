<tryton>
    <data>
        <record model="ir.action.act_window.domain"
            id="account_payment_sepa.act_move_line_form_domain_receivable_mandate">
            <field name="domain"
                eval="['AND', ['OR', ('debit', '&gt;', 0), ('credit', '&lt;', 0)], ('party.sepa_mandates.state', '=', 'validated'), ('payment_type.kind', 'in', ['receivable', 'both']), ('payment_type.account_bank', '=', 'party')]"
                pyson="1"/>
        </record>
    </data>
</tryton>
